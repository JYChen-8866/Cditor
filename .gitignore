# ── Rust build artifacts ──
/target/
*/target/

# ── WASM build outputs ──
*.wasm

# ── Frontend build outputs ──
/dist/
apps/cditor-web/www/dist/

# ── Node dependencies & cache ──
node_modules/
.npm-cache/

# ── macOS installers ──
*.dmg

# ── Environment & secrets ──
/.env

# ── Local databases ──
/workspace.cditor.db
/workspace.cditor.db-shm
/workspace.cditor.db-wal

# ── macOS metadata ──
**/.DS_Store

# ── Local tool state ──
.sc/

# ── Workspace root owns dependency resolution ──
/crates/*/Cargo.lock

# ── Minimal editor assets (temp) ──
/minimal-editor-assets/
/doc/
